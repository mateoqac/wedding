---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
---

<BaseLayout
  title="Partes de matrimonio"
  description="Diseña tu parte de matrimonio en minutos y descárgalo listo para imprimir o compartir."
>
  <main class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-4 py-24 text-center">
    <h1 class="text-4xl font-semibold tracking-tight">Diseña tu parte de matrimonio</h1>
    <p class="text-muted-foreground">
      Elige una plantilla, completa los datos y descárgalo para imprenta, WhatsApp o Instagram.
    </p>
    <Button>Comenzar</Button>
  </main>
</BaseLayout>
