---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/layouts/SiteHeader.astro";
import { formatClp } from "@/lib/money";
import { getContainer } from "@/server/container";

const price = formatClp(getContainer().priceClp);
const steps = [
  { title: "Elige una plantilla", text: "Diseños formales pensados para partes de matrimonio en Chile." },
  { title: "Completa los datos", text: "Ves la vista previa al instante, con marca de agua, sin crear cuenta." },
  { title: "Paga una vez", text: `${price} desbloquean todos los formatos de tu invitación.` },
  { title: "Descarga y comparte", text: "PDF para imprenta, PDF digital, imagen y formato historia para Instagram." },
];
---

<BaseLayout
  title="Partes de matrimonio — diseña y descarga tu invitación"
  description="Diseña tu parte de matrimonio en minutos y descárgalo listo para imprimir o compartir."
>
  <SiteHeader user={Astro.locals.user} />
  <main>
    <section class="mx-auto grid max-w-6xl items-start gap-16 px-4 pt-24 pb-22 lg:grid-cols-2">
      <div class="flex flex-col gap-7 lg:pt-6">
        <h1 class="max-w-xl text-4xl font-semibold tracking-tight text-balance sm:text-[2.75rem] sm:leading-[1.12]">
          Tu parte de matrimonio, listo para imprenta y WhatsApp
        </h1>
        <p class="max-w-lg text-lg text-muted-foreground text-pretty">
          Elige una plantilla clásica, completa los datos y descárgalo en todos los formatos con un solo pago de {price}.
        </p>
        <div>
          <a
            href="/plantillas"
            class="inline-flex h-11 items-center rounded-md bg-primary px-6 font-medium text-primary-foreground hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Ver plantillas
          </a>
        </div>
      </div>
      <figure class="flex flex-col items-start gap-3">
        <img
          src="/api/templates/clasico-marco-doble/thumbnail"
          alt="Vista previa de la plantilla Clásico marco doble con marca de agua"
          width="1000"
          height="714"
          class="aspect-[1000/714] w-full max-w-[30rem] border bg-muted object-cover shadow-xs"
        />
        <figcaption class="text-sm text-muted-foreground">Plantilla Clásico marco doble · vista previa con marca de agua</figcaption>
      </figure>
    </section>
    <section class="border-t" aria-labelledby="como-funciona">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-14 pb-20 lg:grid-cols-3">
        <h2 id="como-funciona" class="text-2xl font-semibold tracking-tight">Cómo funciona</h2>
        <ol class="divide-y border-y lg:col-span-2">
          {steps.map((step, i) => (
            <li class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-4 py-5">
              <span class="text-sm text-muted-foreground tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-semibold">{step.title}</h3>
                <p class="max-w-xl text-[15px] text-muted-foreground">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>
