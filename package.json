{
  "name": "wedding-invitations",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker:preview": "RENDER_MODE=preview PORT=4101 WORKER_SECRET=dev-worker-secret tsx src/render/main.ts",
    "worker:export": "RENDER_MODE=export PORT=4102 WORKER_SECRET=dev-worker-secret tsx src/render/main.ts",
    "workers:up": "docker compose --profile workers up -d --build",
    "test:e2e": "tsx tests/e2e/reset-database.ts && playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:docker": "docker run --rm -v \"$PWD\":/work -v wi-visual-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.65.0-noble bash -c 'npm i -g pnpm@11.22.0 >/dev/null && CI=true pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store >/dev/null && pnpm exec playwright test --config playwright.visual.config.ts'",
    "test:visual:update": "docker run --rm -v \"$PWD\":/work -v wi-visual-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.65.0-noble bash -c 'npm i -g pnpm@11.22.0 >/dev/null && CI=true pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store >/dev/null && pnpm exec playwright test --config playwright.visual.config.ts --update-snapshots'"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/react": "^7.1.8",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "pg-boss": "^12.38.2",
    "playwright": "1.65.0",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "shadcn": "^4.23.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.22.0"
}
